# ── koragraphMCP — local, structural-only configuration ──────────────────────
# Copy to .env. No API keys are required for the shipping path.

# The graph store is a local SQLite file. It creates itself and applies src/db/schema.sql the
# first time it is opened, so there is no migration step and no server to run.
# KORAGRAPH_DB=~/.koragraph/graph.db

# ── The shipping retrieval mode ──────────────────────────────────────────────
# Structural-only: exact (name/path) + lexical (SQLite FTS5) + graph expansion.
# Needs NO embedding server, NO vector index, NO LLM. This is the local product.
RETRIEVAL_LEXICAL_ENABLED=1


# ── Temporal co-change (the plane no competitor ships) ───────────────────────
# Declaration-grain CO_CHANGES edges mined from git history — the temporal-coupling plane. They feed
# blast_radius and changes_with; the benefit is repo-dependent, so treat it as directional until a
# published benchmark lands.
COCHANGE_EDGES=on
COCHANGE_MAX_FILES=20
COCHANGE_MAX_DECLS=30
COCHANGE_MIN_SUPPORT=2
COCHANGE_HALF_LIFE_DAYS=3650
# Cost is linear in commit count (tree-sitter parses each changed file, per commit). The most RECENT
# commits are mined; the default is high enough to be a no-op for an ordinary history and only bounds
# pathological ones (a very deep repo is capped instead of parsed end to end). 0 = full history.
COCHANGE_MAX_COMMITS=10000

# ── Retrieval tuning ─────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=12
SUBGRAPH_MAX_NODES=60

